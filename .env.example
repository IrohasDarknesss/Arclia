# ============================================================================
# Arclia (arXiv日本語研究ダイジェスト Webアプリ) 環境変数設定例
# 基本設計書_概要.md §9 環境変数一覧 (No.1 - No.41) 準拠
# ============================================================================

# --- データベース・キャッシュ・認証 (No.1 - No.6) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- arXiv API 連携 (No.7 - No.12) ---
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf
ARXIV_USER_AGENT=arxiv-digest-jp/0.1 (+mailto:contact@example.com)
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_TARGET_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.NE,cs.RO,cs.IR,stat.ML
ARXIV_FETCH_WINDOW_DAYS=3

# --- LLM・Embedding・要約検証 (No.13 - No.22) ---
LLM_API_KEY=your-llm-api-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL_SUMMARY_SHORT=gpt-4o-mini
LLM_MODEL_SUMMARY_STANDARD=gpt-4o-mini
LLM_MODEL_SUMMARY_DEEP=gpt-4o
LLM_MODEL_VALIDATOR=gpt-4o-mini
LLM_MODEL_AUXILIARY=gpt-4o-mini
EMBEDDING_ENABLED=false
LLM_MODEL_EMBEDDING=text-embedding-3-small
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- 課金 Stripe (No.23 - No.27) ---
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder
PRO_MONTHLY_LIMIT_PER_FEATURE=100

# --- 外部連携 GitHub・メール配信 (No.28 - No.33) ---
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
MAIL_PROVIDER_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
DIGEST_SEND_HOUR_JST=7
DIGEST_MAX_PAPERS_PER_USER=5

# --- バッチ・ワーカー制御 (No.34 - No.38) ---
JOB_MAX_ATTEMPTS=3
FULL_TEXT_DAILY_LIMIT=50
ON_DEMAND_SYNC_WAIT_SECONDS=5
VIEW_EVENTS_RETENTION_DAYS=180
SUMMARIZE_CONCURRENCY=4

# --- 監視・ログ・レート制限 (No.39 - No.41) ---
LOG_LEVEL=INFO
SENTRY_DSN=
API_RATE_LIMIT_PER_MINUTE=60
